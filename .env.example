# Copy this file to .env and adjust the values.

# development = show PHP errors, production = hide them from users
APP_ENV=development

# Host ports
APP_PORT=8080
ADMINER_PORT=8081

# Database (DB_HOST is the service name from docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_NAME=pv_monitor
DB_USER=pv_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
